# ALERT 
OBS_ALERT_WEBHOOK_URL=URL_TO_YOUR_OBSERVABILITY_ALERT_WEBHOOK
SLACK_ALERT_WEBHOOK_URL=URL_TO_YOUR_SLACK_ALERT_WEBHOOK
DISCORD_ALERT_WEBHOOK_URL=URL_TO_YOUR_DISCORD_ALERT_WEBHOOK

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=URL_TO_YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=true
SUPABASE_READS_ENABLED=true
SUPABASE_WRITES_ENABLED=true

# MERCADO PAGO
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=YOUR_MERCADOPAGO_WEBHOOK_SECRET
MERCADOPAGO_BACK_URL=https://www.mercadopago.com.br/subscriptions
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_TEST_PAYER_EMAIL=test_user@testuser.com

# MERCADO PAGO PLAN IDS
MERCADOPAGO_PLAN_PREMIUM_ID=YOUR_MERCADOPAGO_PLAN_PREMIUM_ID
MERCADOPAGO_PLAN_PREMIUM_YEARLY_ID=YOUR_MERCADOPAGO_PLAN_PREMIUM_YEARLY_ID
MERCADOPAGO_PLAN_PRO_ID=YOUR_MERCADOPAGO_PLAN_PRO_ID
MERCADOPAGO_PLAN_PRO_YEARLY_ID=YOUR_MERCADOPAGO_PLAN_PRO_YEARLY_ID
MERCADOPAGO_PLAN_FAMILY_ID=YOUR_MERCADOPAGO_PLAN_FAMILY_ID
MERCADOPAGO_PLAN_FAMILY_YEARLY_ID=YOUR_MERCADOPAGO_PLAN_FAMILY_YEARLY_ID
MERCADOPAGO_PLAN_BUSINESS_ID=YOUR_MERCADOPAGO_PLAN_BUSINESS_ID
MERCADOPAGO_PLAN_BUSINESS_YEARLY_ID=YOUR_MERCADOPAGO_PLAN_BUSINESS_YEARLY_ID

# MERCADO PAGO PLAN (R$ 9,90 - 12 months) for first users
MERCADOPAGO_PLAN_FOUNDATION_ID=YOUR_MERCADOPAGO_PLAN_FOUNDATION_ID
NEXT_PUBLIC_FOUNDATION_PLAN_ACTIVE=false
FOUNDATION_PLAN_MAX_USERS=30

# CRON
CRON_SECRET=YOUR_CRON_SECRET
BILLING_RECONCILE_CRON_LIMIT=50

# UPSTASH REDIS
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
